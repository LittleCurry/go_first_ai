# 大模型API配置
DEEPSEEK_API_KEY=xxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# 向量数据库配置
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# RAG配置
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Agent配置
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30

# Redis配置（新增）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ai_customer_service

# 应用配置
API_PORT=8000
DEBUG=true